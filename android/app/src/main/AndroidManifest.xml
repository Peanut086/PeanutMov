<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限最小化（REV-03 / SRS 6.5）：
      · INTERNET：浏览远程源、播放远程直链、下载视频；
      · WAKE_LOCK：播放时保持屏幕常亮（@capacitor-community/keep-awake）；
      · FOREGROUND_SERVICE：下载服务前台运行，切后台不中断；
      · FOREGROUND_SERVICE_DATA_SYNC：Android 14+ 前台服务类型声明；
      · POST_NOTIFICATIONS：Android 13+ 下载进度通知 + 节目提醒（EXT-06）；
      · ACCESS_NETWORK_STATE：检测网络类型（WiFi/移动数据）决定是否下载；
      · SCHEDULE_EXACT_ALARM：节目提醒需准点触发（Android 12+，EXT-06/AC-168）；
      · RECEIVE_BOOT_COMPLETED：重启后重建已排期的节目提醒（EXT-06/AC-170）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      EXT-06 / FR-71（API-24）：节目提醒的准点触发。
      · Android 12/12L（31/32）：声明即授予；缺失时 AlarmManager.canScheduleExactAlarms()
        恒为 false，@capacitor/local-notifications 会静默退化为非精确闹钟；
      · Android 13（33）：默认授予，用户可在系统设置撤销；
      · Android 14+（34+，本工程 targetSdk 35）：默认**不**授予，需用户在
        「设置 → 应用 → 特殊权限 → 闹钟和提醒」手动开启，否则提醒仍会触发但可能延迟。
        运行期实际状态由 ReminderNotifications 在启动时写入应用日志
        （filesDir/logs/spider-YYYY-MM-DD.log，本地日志查看页可读）。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      EXT-06 / AC-170：设备重启后重建已排期的提醒。
      receiver 本身由 @capacitor/local-notifications 的 manifest 合并提供
      （LocalNotificationRestoreReceiver，监听 BOOT_COMPLETED / LOCKED_BOOT_COMPLETED /
      QUICKBOOT_POWERON），它同时自带同权限声明；此处显式声明以固化意图，
      重复声明由 manifest merger 去重。本工程**不**另建 BOOT receiver：两套恢复逻辑
      会各自排期同一通知 id，属于重复状态源。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- P0: 网盘账号登录需要写 /sdcard/TVBox/ 目录（TVBox jar 爬虫约定路径） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- AND-05 修复：OPT-06 抬 minSdk 到 29 后，API 29 仍需 WRITE_EXTERNAL_STORAGE 配合 requestLegacyExternalStorage -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 下载前台服务（Phase 1） -->
        <service
            android:name=".download.DownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- P1: 网盘登录页 -->
        <activity
            android:name=".NetdiskLoginActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
    </application>

</manifest>
