<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 本地服务与 WebView 自包含资源：允许明文（ capacitor.config.ts: server.cleartext = true ） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- 用户自建源（AList/WebDAV/Jellyfin/站点）可能是 http 内网地址，需要明文访问；
         风险由用户自行确认（App 内已在合规声明与源管理提示） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.31.0</domain>
        <domain includeSubdomains="true">192.168.50.0</domain>
        <domain includeSubdomains="true">192.168.51.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">1.0.168.192.in-addr.arpa</domain>
    </domain-config>
</network-security-config>
