# ---------------------------------------------------------------
# PeanutMov 环境变量示例
# 复制为 .env.local 后按需修改（.env*.local 不入库）
# 注意：Vite 只会把 VITE_ 前缀的变量注入客户端，勿在此放真实凭据
# ---------------------------------------------------------------

# 应用显示名（用于页面标题兜底）
VITE_APP_NAME=PeanutMov

# 演示源与公开样片的基地址（留空则使用 data/demo/demoCatalog.ts 内置的公开地址）
VITE_DEMO_BASE=

# 启动时是否启用契约 mock（"1" 启用；集成阶段删除 mock 后置为 "0"）
VITE_USE_MOCK=1

# 是否输出 debug 级日志（"1" 启用；生产构建恒为关闭）
VITE_DEBUG_LOG=0

# 后台接口前缀（首版无服务端，保留占位，勿填第三方片源地址）
VITE_API_BASE=
